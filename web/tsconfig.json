{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "/web/threejs-shim.js": ["./threejs-shim.d.ts"],
      "/web/video-export.js": ["./video-export.d.ts"],
      "/web/pkg/threers.js": ["./pkg/threers.d.ts"]
    }
  },
  "include": [
    "threejs-shim.d.ts",
    "light-probe-grid.d.ts",
    "light-probe-math.d.ts",
    "video-export.d.ts",
    "examples/controls-threers.ts",
    "examples/export-video.ts"
  ],
  "exclude": [
    "examples/controls-threejs.ts"
  ]
}
